# Environment Configuration

# API Keys (REQUIRED)
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
DEBUG=False

# Database
DATABASE_URL=sqlite:///./jc_production.db
DATABASE_BACKUP_PATH=./backups/
DATABASE_CHECKPOINT_INTERVAL=3600

# Session Management
SESSION_TIMEOUT=3600
SESSION_MAX_AGE=86400
SESSION_STORE=sqlite

# Voice Configuration
STT_PROVIDER=openai
TTS_PROVIDER=openai
VAD_ENABLED=True
BARGE_IN_ENABLED=True
VOICE_SAMPLE_RATE=16000

# Agent Configuration
DEFAULT_MODEL=gpt-4
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000
AGENT_MEMORY_SIZE=20
CONTEXT_WINDOW_SIZE=8000

# Autonomy & Safety
AUTONOMY_LEVEL=bounded
REQUIRE_APPROVAL_FOR_MUTATIONS=True
MAX_AUTONOMOUS_ACTIONS=100
EMERGENCY_STOP_ENABLED=True

# Security
ZERO_TRUST_ENABLED=True
SECRETS_BACKEND=env
AUDIT_LOG_ENABLED=True
AUDIT_LOG_PATH=./logs/audit/

# Real-time Runtime
WORKER_COUNT=4
EVENT_STREAM_BACKEND=memory
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Disaster Recovery
DISASTER_RECOVERY_MODE=normal
BACKUP_ENABLED=True
BACKUP_INTERVAL=3600
BACKUP_RETENTION_DAYS=30

# Monitoring & Observability
METRICS_ENABLED=True
TRACE_ENABLED=False
ANOMALY_DETECTION_ENABLED=True
HEALTH_CHECK_INTERVAL=60

# Feature Flags
FEATURE_STREAMING=True
FEATURE_VOICE=True
FEATURE_TOOL_CALLING=True
FEATURE_AUTONOMOUS_EXECUTION=True
FEATURE_KNOWLEDGE_GRAPH=True

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Integration
WEBHOOK_SIGNATURE_SECRET=your_webhook_secret
EXTERNAL_INTEGRATION_TIMEOUT=30
